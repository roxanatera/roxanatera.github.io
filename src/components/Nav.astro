---
const links = [
  { href: "#about", es: "Sobre mí", en: "About" },
  { href: "#skills", es: "Habilidades", en: "Skills" },
  { href: "#projects", es: "Proyectos", en: "Projects" },
  { href: "#education", es: "Formación", en: "Education" },
  { href: "#contact", es: "Contacto", en: "Contact" },
];
---
<nav
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-8 py-4 md:py-5 bg-[#07070f]/80 backdrop-blur-md border-b border-cyan-500/10"
>
  <a href="/" class="font-bold text-xl tracking-tight text-white"
    >JRN<span class="text-cyan-400">.</span>
  </a>
  <ul class="hidden md:flex gap-8 list-none">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-gray-400 hover:text-cyan-400 transition-colors text-sm tracking-wide"
            data-es={link.es}
            data-en={link.en}
          >
            {link.es}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="flex items-center gap-3">
    <button
      id="langToggle"
      class="border border-cyan-500/20 text-cyan-400 px-3 md:px-4 py-1.5 rounded text-xs font-bold tracking-wider hover:bg-cyan-400/10 transition-colors cursor-pointer bg-transparent"
    >EN</button>
    <button
      id="menuToggle"
      class="md:hidden text-gray-400 hover:text-cyan-400 transition-colors"
      aria-label="Menú"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</nav>

<div
  id="mobileMenu"
  class="fixed top-[65px] left-0 right-0 z-40 bg-[#07070f]/95 backdrop-blur-md border-b border-cyan-500/10 hidden flex-col px-6 py-4 gap-4"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class="text-gray-400 hover:text-cyan-400 transition-colors text-sm py-2 border-b border-cyan-500/10"
        data-es={link.es}
        data-en={link.en}
      >
        {link.es}
      </a>
    ))
  }
</div>
