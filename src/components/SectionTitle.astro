---
interface Props {
  eyebrow: { es: string; en: string };
  title: { es: string; en: string };
  class?: string;
}
const { eyebrow, title, class: className = "" } = Astro.props;
---
<p
  class="text-xs tracking-[0.2em] uppercase text-cyan-400 mb-3 block text-center"
  data-es={eyebrow.es}
  data-en={eyebrow.en}
>
  {eyebrow.es}
</p>
<h2
  class:list={["text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-center", className]}
  data-es={title.es}
  data-en={title.en}
>
  {title.es}
</h2>
