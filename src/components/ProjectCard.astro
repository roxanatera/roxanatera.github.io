---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const pill = "bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs";
---
<div
  class="relative bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-8 hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all overflow-hidden"
>
  {
    project.image && (
      <>
        <div class="absolute inset-0 opacity-10">
          <img src={project.image} alt="" class="w-full h-full object-cover" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#07070f] via-[#07070f]/80 to-transparent"></div>
      </>
    )
  }
  <div class="relative z-10">
    <div class="flex justify-between items-start mb-5">
      <span class="text-3xl md:text-4xl">{project.icon}</span>
      <a
        href={project.repo}
        target="_blank"
        rel="noopener"
        class="text-gray-500 hover:text-cyan-400 text-xs transition-colors"
        >GitHub →</a
      >
    </div>
    <h3 class="font-bold text-base md:text-lg mb-3">{project.name}</h3>
    <p
      class="text-gray-500 text-xs md:text-sm mb-6 leading-relaxed"
      data-es={project.description.es}
      data-en={project.description.en}
    >
      {project.description.es}
    </p>
    <div class="flex gap-2 flex-wrap">
      {project.tags.map((tag) => <span class={pill}>{tag}</span>)}
      {
        project.badge && (
          <span class={pill} data-es={project.badge.es} data-en={project.badge.en}>
            {project.badge.es}
          </span>
        )
      }
    </div>
  </div>
</div>
