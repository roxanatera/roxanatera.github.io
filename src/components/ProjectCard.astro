---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const pill = "bg-cyan-400/8 border border-cyan-400/20 text-cyan-400 px-3 py-1 rounded-full text-xs";
---
<div
  data-project
  data-area={project.area}
  class="relative flex flex-col bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-7 hover:border-cyan-400/30 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all overflow-hidden"
>
  {
    project.image && (
      <>
        <div class="absolute inset-0 opacity-10">
          <img src={project.image} alt="" class="w-full h-full object-cover" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#07070f] via-[#07070f]/80 to-transparent"></div>
      </>
    )
  }
  <div class="relative z-10 flex flex-col flex-1">
    <div class="flex justify-between items-start mb-4">
      <span class="text-3xl">{project.icon}</span>
      <a
        href={project.repo}
        target="_blank"
        rel="noopener"
        class="text-gray-400 hover:text-cyan-400 text-xs transition-colors"
        >GitHub →</a
      >
    </div>
    <h3 class="font-bold text-base md:text-lg mb-2">{project.name}</h3>
    <p class="text-gray-400 text-xs md:text-sm mb-4 leading-relaxed" data-es={project.description.es} data-en={project.description.en}>
      {project.description.es}
    </p>
    <p class="text-xs leading-relaxed mb-5 pl-3 border-l-2 border-cyan-400/40 text-gray-300" data-es={project.outcome.es} data-en={project.outcome.en}>
      {project.outcome.es}
    </p>
    <div class="flex gap-2 flex-wrap mt-auto">
      {project.tags.map((tag) => <span class={pill}>{tag}</span>)}
    </div>
  </div>
</div>
