---
import SectionTitle from "./SectionTitle.astro";

const groups = [
  {
    es: "Desarrollo",
    en: "Development",
    items: ["Go", "Python", "TypeScript", "JavaScript", "Node.js", "React", "Next.js", "Tailwind CSS", "APIs REST", "Microservicios", "SQL", "MongoDB"],
  },
  {
    es: "Cloud y DevOps",
    en: "Cloud & DevOps",
    items: ["AWS Lambda", "API Gateway", "DynamoDB", "Cognito", "Docker", "Kubernetes", "Terraform", "CI/CD"],
  },
  {
    es: "Seguridad",
    en: "Security",
    items: ["Nmap", "WPScan", "Kali Linux", "Notary v2 / Notation", "Auditoría Linux", "Prometheus", "Grafana", "Loki", "PBKDF2", "AES-256-GCM"],
  },
  {
    es: "Sistemas y herramientas",
    en: "Systems & tools",
    items: ["Linux (Ubuntu)", "Bash", "Git", "GitHub", "WordPress", "GNS3"],
  },
];
---
<section id="skills" class="py-16 md:py-24 px-6 md:px-8 bg-[#0d0d1a]">
  <div class="max-w-6xl mx-auto">
    <SectionTitle
      eyebrow={{ es: "Lo que sé hacer", en: "What I can do" }}
      title={{ es: "Habilidades", en: "Skills" }}
      class="mb-10 md:mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      {
        groups.map((group) => (
          <div class="bg-white/3 border border-cyan-500/10 rounded-xl p-6 md:p-7">
            <h3 class="font-bold text-base mb-4 text-cyan-400" data-es={group.es} data-en={group.en}>
              {group.es}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="bg-white/5 border border-cyan-500/10 text-gray-300 px-3 py-1 rounded text-xs">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
